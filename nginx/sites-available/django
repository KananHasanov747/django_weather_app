# FIX: Nginx doesn't have access to these dirs: sudo chmod +x /home /home/ubuntu /home/ubuntu/app
server {
  listen 80;
  server_name <EC2.PUBLIC.DOMAIN.OR.IP>; # AWS EC2 Public IP (e.g., 13.48.70.77)


  location / {
    proxy_pass http://unix:/run/gunicorn.sock; # runs using gunicorn.socket
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header User-Agent $http_user_agent;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /static/ {
    alias /home/ubuntu/app/staticfiles/;
  }

  # Gzip compression
  gzip on;
  gzip_comp_level 6;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

  # Brotli compression
  # brotli on;
  # brotli_comp_level 4;
  # brotli_types text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript;
}
